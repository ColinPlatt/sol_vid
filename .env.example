# Copy to .env; this file contains placeholders only. .env is gitignored.
# Sepolia RPC; full video metadata reads require a sufficiently high eth_call gas cap.
SEPOLIA_RPC_URL=
# Deployer signing key, 0x-prefixed. Keep the real value only in your local .env.
DEPLOYER_PRIVATE_KEY=
# Public Ethereum address corresponding to DEPLOYER_PRIVATE_KEY.
DEPLOYER_ADDRESS=
# Optional source verification API key.
ETHERSCAN_API_KEY=
