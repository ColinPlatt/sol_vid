{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/gallery.html",
      "destination": "/#minted",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/t/:id(\\d+).png",
      "destination": "/api/card?id=:id"
    },
    {
      "source": "/t/:id(\\d+).gif",
      "destination": "/api/gif?id=:id"
    },
    {
      "source": "/t/:id(\\d+)",
      "destination": "/api/token?id=:id"
    }
  ]
}
